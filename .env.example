# Copie para .env (não é versionado) e preencha. Nunca cole a chave em chats ou no Git.
# Serve qualquer API compatível com a de chat da OpenAI. Exemplos de DFC_LLM_BASE_URL (confira o ID do modelo no painel do provedor):
#   OpenRouter  https://openrouter.ai/api/v1
#   Maritaca    https://chat.maritaca.ai/api  (modelos sabia-4 e sabiazinho-4)
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai  (só o plano pago não usa o conteúdo para melhorar produtos do Google)
DFC_LLM_BASE_URL=https://openrouter.ai/api/v1
DFC_LLM_API_KEY=
# Modelo pago e FIXO para o estudo (registre o ID exato). O juiz deve ser outro modelo, de preferência de outra família.
DFC_GEN_MODEL=
DFC_JUDGE_MODEL=
# Use 1 só se o modelo aceitar response_format=json_object.
DFC_JSON_MODE=0
